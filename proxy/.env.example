# Server configuration
PORT=8080
HOST=127.0.0.1

# Logging
LOG_LEVEL=info

# Cursor Agent CLI
# Use "agent" when the executable is available on PATH.
CURSOR_AGENT_PATH=agent
CURSOR_CLI_WARMUP=false
CURSOR_PROACTIVE_CHAT=true

# Optional isolated workspace and conversation database paths
CURSOR_BRIDGE_WORKSPACE=
CURSOR_SESSION_STORE_PATH=

# Optional Cursor CLI API key
CURSOR_API_KEY=

# Timeout for a Cursor request (in milliseconds)
CURSOR_TIMEOUT_MS=300000

# Default Cursor model when the request asks for "cursor"
CURSOR_DEFAULT_MODEL=auto

# Debug: dump raw CLI output to ./debug/
DEBUG_DUMP_OUTPUT=false
